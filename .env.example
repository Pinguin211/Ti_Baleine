# ==========================================================
# Variables d'environnement — Ti'Baleine
# ==========================================================

# Base de données PostgreSQL
# Dans le conteneur Docker : postgres://postgres:postgres@db:5432/ti_baleine
# En local sur l'hôte : postgres://postgres:postgres@localhost:5432/ti_baleine
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ti_baleine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ti_baleine

# Environnement
NODE_ENV=development

# Secret de signature des sessions administrateur (JWT, cookie httpOnly).
# Obligatoire en production. Générer avec : openssl rand -base64 32
AUTH_SECRET=

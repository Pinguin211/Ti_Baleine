# ==========================================================
# Variables d'environnement — Ti'Baleine
# ==========================================================

# Base de données PostgreSQL
# Dans le conteneur Docker : postgres://postgres:postgres@db:5432/ti_baleine
# En local sur l'hôte : postgres://postgres:postgres@localhost:5432/ti_baleine
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ti_baleine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ti_baleine

# Environnement
NODE_ENV=development

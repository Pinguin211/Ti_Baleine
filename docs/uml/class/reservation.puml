@startuml
title Diagramme de Classes — Ti'Baleine

' Configuration d'affichage
skinparam roundcorner 8
skinparam classAttributeIconSize 0

class Client {
    +nom : string
    +prenom : string
    +email : string
    +telephone : string
    +reserverCreneau()
}

class Administrateur {
    +identifiant : string
    +motDePasse : string
    +role : string
    +annulerReservation(refReservation : string)
}

class Reservation {
    +reference : string
    +dateDepart : DateTime
    +heureDepart : string
    +statut : StatutReservation
    +annuler()
    +calculerMontantTotal() : float
}

class Billet {
    +categorie : CategoriePassager
    +prixUnitaire : float
}

class TypeDeSortie {
    +nomPrestation : string
    +lieuDepart : string
    +format : FormatSortie
}

class Notification {
    +message : string
    +dateEnvoi : DateTime
    +type : TypeNotification
    +envoyer()
}

enum StatutReservation {
    CONFIRMEE
    ANNULEE
}

enum CategoriePassager {
    ADULTE
    ENFANT_4_11
}

' Relations
Client "1" -- "0..*" Reservation : effectue >
Administrateur ..> Reservation : gère l'annulation
Reservation "1" *-- "1..*" Billet : contient >
Reservation "1" --> "1" TypeDeSortie : concerne >
Reservation "1" --> "0..*" Notification : déclenche >
Billet --> CategoriePassager : type >

@enduml
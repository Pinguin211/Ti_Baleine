@startuml mpd
title **Modèle Physique de Données (MPD) — Ti'Baleine**\n//Persistance PostgreSQL, UUID et Énumérations Métier — CDC v5 (paiement scindé, token solde, pré-alerte)//

skinparam monochrome false
skinparam roundcorner 8
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam dpi 150
skinparam shadowing false
skinparam packageStyle rectangle

' ==========================================================
' 1. ÉNUMÉRATIONS (Custom ENUM Types)
' ==========================================================
package "Énumérations (Types ENUM)" as EnumsPkg #ECEFF1 {
  enum role_enum <<ENUM>> {
    CLIENT
    ADMIN
  }

  enum port_enum <<ENUM>> {
    SAINT_GILLES
    SAINT_LEU
  }

  enum activite_enum <<ENUM>> {
    BALEINES
    DAUPHINS
    PRIVATISATION_TIKAP
    PRIVATISATION_GRAND_BLEU
  }

  enum type_billet_enum <<ENUM>> {
    ADULTE
    ENFANT
    PRIVATISATION
  }

  enum statut_reservation_enum <<ENUM>> {
    EN_ATTENTE_PAIEMENT
    PAYEE_PARTIELLEMENT
    PAYEE_COMPLETEMENT
    ANNULEE
  }

  enum type_paiement_enum <<ENUM>> {
    ACOMPTE
    SOLDE
  }

  enum canal_paiement_enum <<ENUM>> {
    EN_LIGNE
    SUR_PLACE_CB
  }

  enum statut_emission_facture_enum <<ENUM>> {
    EN_ATTENTE
    ENVOYEE_SUCCES
    ECHEC_ENVOI
  }
}

' ==========================================================
' 2. TABLES PERSISTÉES DU DOMAINE
' ==========================================================
package "Tables Persistées (Base Relationnelle)" as TablesPkg #FFFFFF {

  entity "users" as users {
    * **id** : UUID <<PK, DEFAULT gen_random_uuid()>>
    --
    * **nom** : VARCHAR(100) <<NOT NULL>>
    * **prenom** : VARCHAR(100) <<NOT NULL>>
    * **email** : VARCHAR(255) <<UQ, NOT NULL>>
    * **telephone** : VARCHAR(20) <<NOT NULL>>
    * **role** : role_enum <<NOT NULL, DEFAULT 'CLIENT'>>
    * **mot_de_passe** : VARCHAR(255) <<NULLABLE>>
  }

  entity "alertes" as alertes {
    * **id** : UUID <<PK, DEFAULT gen_random_uuid()>>
    --
    * **message** : TEXT <<NOT NULL>>
    * **date_emission** : TIMESTAMPTZ <<NOT NULL, DEFAULT NOW()>>
  }

  entity "creneaux" as creneaux {
    * **id** : UUID <<PK, DEFAULT gen_random_uuid()>>
    --
    * **date** : DATE <<NOT NULL>>
    * **heure_depart** : TIME <<NOT NULL>>
    * **port** : port_enum <<NOT NULL>>
    * **activite** : activite_enum <<NOT NULL>>
    * **est_ouvert** : BOOLEAN <<NOT NULL, DEFAULT TRUE>>
    * **sous_pre_alerte** : BOOLEAN <<NOT NULL, DEFAULT FALSE>>
    * **alerte_id** : UUID <<FK, NULLABLE>>
  }

  entity "reservations" as reservations {
    * **id** : UUID <<PK, DEFAULT gen_random_uuid()>>
    --
    * **reference** : VARCHAR(20) <<UQ, NOT NULL>>
    * **statut** : statut_reservation_enum <<NOT NULL, DEFAULT 'EN_ATTENTE_PAIEMENT'>>
    * **creneau_id** : UUID <<FK, NOT NULL>>
    * **user_id** : UUID <<FK, NOT NULL>>
    * **date_creation** : TIMESTAMPTZ <<NOT NULL, DEFAULT NOW()>>
  }

  entity "billets" as billets {
    * **id** : UUID <<PK, DEFAULT gen_random_uuid()>>
    --
    * **reservation_id** : UUID <<FK, NOT NULL>>
    * **type_billet** : type_billet_enum <<NOT NULL>>
  }

  entity "paiements" as paiements {
    * **id** : UUID <<PK, DEFAULT gen_random_uuid()>>
    --
    * **reservation_id** : UUID <<FK, NOT NULL>>
    * **type_paiement** : type_paiement_enum <<NOT NULL>>
    * **canal_paiement** : canal_paiement_enum <<NOT NULL>>
    * **reference_transaction** : VARCHAR(100) <<UQ, NOT NULL>>
    * **montant** : DECIMAL(10,2) <<NOT NULL>>
    * **date_paiement** : TIMESTAMPTZ <<NOT NULL, DEFAULT NOW()>>
    * **reference_facture** : VARCHAR(50) <<UQ, NOT NULL>>
    * **statut_emission_facture** : statut_emission_facture_enum <<NOT NULL, DEFAULT 'EN_ATTENTE'>>
    * **date_emission_facture** : TIMESTAMPTZ <<NULLABLE>>
  }

  entity "tokens_paiement_solde" as tokens {
    * **id** : UUID <<PK, DEFAULT gen_random_uuid()>>
    --
    * **reservation_id** : UUID <<FK, UQ, NOT NULL>>
    * **token** : VARCHAR(255) <<UQ, NOT NULL>>
    * **date_creation** : TIMESTAMPTZ <<NOT NULL, DEFAULT NOW()>>
    * **date_expiration** : TIMESTAMPTZ <<NOT NULL>>
    * **est_utilise** : BOOLEAN <<NOT NULL, DEFAULT FALSE>>
  }
}

' ==========================================================
' 3. RELATIONS PHYSIQUES (Contraintes Foreign Keys)
' ==========================================================
alertes ||--o{ creneaux : "FK: alerte_id (SET NULL)"
creneaux ||--o{ reservations : "FK: creneau_id (RESTRICT)"
users ||--o{ reservations : "FK: user_id (RESTRICT)"
reservations ||--o{ billets : "FK: reservation_id (CASCADE)"
reservations ||--o{ paiements : "FK: reservation_id (RESTRICT / 0..2)"
reservations ||--o| tokens : "FK: reservation_id (CASCADE / 0..1)"

' ==========================================================
' 4. LIAISONS AUX TYPES ÉNUMÉRÉS
' ==========================================================
users .down.> role_enum : "role"
creneaux .down.> port_enum : "port"
creneaux .down.> activite_enum : "activite"
reservations .down.> statut_reservation_enum : "statut"
billets .down.> type_billet_enum : "type_billet"
paiements .down.> type_paiement_enum : "type_paiement"
paiements .down.> canal_paiement_enum : "canal_paiement"
paiements .down.> statut_emission_facture_enum : "statut_emission_facture"

@enduml

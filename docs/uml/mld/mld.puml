@startuml mld
title Modèle Logique de Données (MLD) — Ti'Baleine

skinparam monochrome false
skinparam roundcorner 8
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam dpi 150

entity "USERS\n(Utilisateurs)" as USERS {
  * **id** : Identifiant unique [PK]
  --
  * **email** : Adresse e-mail [UNIQUE]
  password_hash : Mot de passe chiffré (null = client invité)
  * **first_name** : Prénom
  * **last_name** : Nom de famille
  phone : Numéro de téléphone mobile
  * **role** : Rôle (CLIENT, ADMIN)
  * **created_at** : Date de création
  * **updated_at** : Date de modification
}

entity "ALERTS\n(Alertes de pré-annulation)" as ALERTS {
  * **id** : Identifiant unique [PK]
  --
  * **message** : Message bilingue combiné (FR + EN)
  * **created_at** : Date d'émission (veille à 18h)
}

entity "SLOTS\n(Créneaux)" as SLOTS {
  * **id** : Identifiant unique [PK]
  --
  * **slot_date** : Date de la sortie
  * **departure_time** : Heure de départ (07:00, 09:00, 10:00, 14:00)
  * **port** : Port d'embarquement (SAINT_GILLES, SAINT_LEU)
  * **activite** : Prestation (BALEINES, DAUPHINS, PRIVATISATION_TIKAP, PRIVATISATION_GRAND_BLEU)
  * **is_open** : Ouvert à la vente (Oui / Non)
  # alert_id : Alerte ciblant le créneau [FK, nullable]
}

entity "BOOKINGS\n(Réservations)" as BOOKINGS {
  * **id** : Identifiant unique [PK]
  --
  * **booking_ref** : Référence de réservation [UNIQUE]
  * **# user_id** : Client / administrateur associé [FK]
  * **# slot_id** : Créneau réservé [FK]
  * **status** : Statut (EN_ATTENTE_PAIEMENT, CONFIRMEE, ANNULEE)
  * **created_at** : Date de création
}

entity "BOOKING_ITEMS\n(Billets)" as BOOKING_ITEMS {
  * **id** : Identifiant unique [PK]
  --
  * **# booking_id** : Réservation associée [FK]
  * **type_billet** : Type de billet (ADULTE, ENFANT, PRIVATISATION)
}

entity "PAYMENTS\n(Paiements)" as PAYMENTS {
  * **id** : Identifiant unique [PK]
  --
  * **# booking_id** : Réservation réglée [FK, UNIQUE]
  * **transaction_ref** : Référence de transaction bancaire [UNIQUE]
  * **amount_cents** : Montant encaissé (en centimes)
  * **paid_at** : Date du paiement
  invoice_ref : Référence de facture [UNIQUE] (ex. FACT-2026-00123)
  * **invoice_emission_status** : Statut d'émission facture (EN_ATTENTE, ENVOYEE_SUCCES, ECHEC_ENVOI)
  invoice_emitted_at : Date d'émission de la facture
}

USERS "1" -- "0..*" BOOKINGS : effectue >
SLOTS "1" -- "0..*" BOOKINGS : regroupe >
ALERTS "0..1" -- "1..*" SLOTS : cible >
BOOKINGS "1" -- "0..*" BOOKING_ITEMS : comprend >
BOOKINGS "1" -- "0..1" PAYMENTS : est réglée par >

note bottom of SLOTS
  Unicité d'un créneau : (slot_date + departure_time + port + activite).
  Jauge et places restantes non stockées → calculées à la volée
  (config navire/port + billets). Les configurations
  (ConfigPort/Bateau/Activite/Skipper) sont codées en dur : non persistées.
end note

note bottom of PAYMENTS
  Paiement présent uniquement si réglé avec succès.
  Entités « Temporaires » du domaine (Facture, NotificationSMS,
  NotificationEmail) non persistées : générées à la volée.
  Seule la traçabilité de la facture est conservée ici.
end note

@enduml

@startuml
!theme plain
top to bottom direction
skinparam roundcorner 10
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

title **Diagramme de Classes du Domaine — Ti'Baleine**\n//Traçabilité avec les Spécifications (specs/reservation.md, specs/facturation.md, specs/admin.md)//

' ==========================================================
' CONFIGURATIONS CONSTANTES (Fichiers en dur)
' ==========================================================
package "Configuration Constante (fichiers en dur)" as ConfigPkg #F8F9FA {
    class ConfigBateau <<(C,#B0BEC5) Configuration>> {
        +id: String
        +nom: String
        +capacite: Integer
    }
    note bottom of ConfigBateau
      **SPEC-RESERVATION-03, SPEC-ADMIN-01, SPEC-ADMIN-05**
      - TIKAP : 12 places (opère à St-Leu mar/jeu matin)
      - GRAND BLEU : 24 places (opère à St-Gilles)
      - Jauge max selon navire(s) mobilisé(s) (R-03, C-04)
    end note

    class ConfigPort <<(C,#B0BEC5) Configuration>> {
        +id: String
        +nom: String
        +majorationIndividuelle: Float
        +joursOuverts: List<String>
    }
    note bottom of ConfigPort
      **SPEC-RESERVATION-03, SPEC-ADMIN-01**
      - Saint-Gilles : 7j/7 (créneaux 7h, 10h, 14h), majoration 0 €
      - Saint-Leu : mar/jeu matin (9h00), majoration +10 €/pers
      - Référence : R-01, R-05, R-20, C-03, C-11
    end note

    class ConfigActivite <<(C,#B0BEC5) Configuration>> {
        +id: String
        +nom: String
        +categorie: CategorieActivite
        +tarifBaseAdulte: Float
        +tarifBaseEnfant: Float
        +forfait: Float
        +necessiteNaturaliste: Boolean
    }
    note bottom of ConfigActivite
      **SPEC-RESERVATION-03, SPEC-ADMIN-07**
      - Baleines : 65 € / 40 €, naturaliste obligatoire unique (R-15)
      - Dauphins : 50 € / 30 €, sans naturaliste
      - Privatisation Tikap : forfait 600 €
      - Privatisation Grand Bleu : forfait 1 100 €
      - Référence : R-04, R-12, R-19, C-12, C-19
    end note
}

' ==========================================================
' DOMAINE APPLICATIF (Entités dynamiques en Base)
' ==========================================================
package "Domaine Applicatif" as DomainPkg {

    class User {
        +id: UUID
        +nom: String
        +prenom: String
        +email: String
        +telephone: String
        +role: Role
        +motDePasse: String
    }
    note right of User
      **SPEC-RESERVATION-03, SPEC-ADMIN-04**
      - Role CLIENT : mode invité sans compte, mobile obligatoire pour SMS
      - Role ADMIN : profil unique back-office desktop sécurisé (C-16, REQ-103)
    end note

    class Alerte {
        +id: UUID
        +message: String
    }
    note right of Alerte
      **SPEC-ADMIN-06, SPEC-RESERVATION-03**
      - Émission groupée J-1 18h par l'admin sur 1..* créneaux (SPEC-ADMIN-06)
      - Message bilingue combiné FR + EN (R-26, C-23)
      - Active la mention d'avertissement sur le créneau en ligne (REQ-019, R-25)
      - Ouvre droit au remboursement 100 % (R-27, R-28, C-36)
    end note

    class Creneau {
        +id: UUID
        +date: Date
        +heureDepart: Time
        +typeActivite: TypeActivite
        +estOuvert: Boolean
        +calculerJauge(): Integer
        +calculerPlacesReservees(): Integer
        +placesRestantes(): Integer
        +estReservable(): Boolean
    }
    note right of Creneau
      **SPEC-RESERVATION-03, SPEC-ADMIN-01, SPEC-ADMIN-05, SPEC-ADMIN-07**
      - Jauge max : 36 standard, 24 mar/jeu matin St-Gilles, 12 St-Leu
      - Clôture automatique à H-2 (R-11, C-07)
      - Fermeture annuelle : 25 déc & 1er janv (R-02, C-02)
      - Seuil de maintien : 6 passagers payants (R-09)
      - Exclusivité d'activité par créneau/navire (R-12, C-18)
    end note

    class Reservation {
        +id: UUID
        +reference: String
        +statut: StatutReservation
        +calculerMontantTotal(): Float
    }
    note right of Reservation
      **SPEC-RESERVATION-03, SPEC-ADMIN-02, SPEC-ADMIN-03**
      - Réservation en ligne grand public (SPEC-RESERVATION-03)
      - Annulation admin : libération synchrone des places (SPEC-ADMIN-02)
      - Réduction passagers admin : sans ajout ni report (SPEC-ADMIN-03)
    end note

    class Billet {
        +id: UUID
        +trancheAge: TrancheAge
    }
    note right of Billet
      **SPEC-RESERVATION-03, SPEC-ADMIN-02, SPEC-ADMIN-03**
      - ADULTE : >= 12 ans (plein tarif calculé par config)
      - ENFANT : 4 à 11 ans inclus (tarif réduit calculé par config)
      - Moins de 4 ans : accès strictement interdit (R-06)
      - Tout billet présent est actif (supprimé lors d'annulation/réduction)
    end note

    class Notification {
        +id: UUID
        +message: String
    }
    note right of Notification
      **SPEC-ADMIN-02, SPEC-ADMIN-03**
      - Entité temporaire de notification au client
      - Émise lors de l'annulation d'une réservation (SMS d'information avec motif saisi)
    end note

    class Paiement {
        +id: UUID
        +referenceTransaction: String
        +montant: Float
        +datePaiement: DateTime
    }
    note right of Paiement
      **SPEC-RESERVATION-03, SPEC-FAC-02**
      - Règlement 100 % par carte bancaire sécurisée (REQ-006, R-07)
      - Présent uniquement si validé avec succès
      - Déclenche la génération de facture acquittée à la volée (SPEC-FAC-02)
    end note
}

' ==========================================================
' ÉNUMÉRATIONS
' ==========================================================
package "Énumérations" as EnumPkg #ECEFF1 {
    enum Role {
        CLIENT
        ADMIN
    }

    enum TypeActivite {
        BALEINES_SAINT_GILLES
        BALEINES_SAINT_LEU
        DAUPHINS_SAINT_GILLES
        DAUPHINS_SAINT_LEU
        PRIVATISATION_TIKAP_ST_GILLES
        PRIVATISATION_TIKAP_ST_LEU
        PRIVATISATION_GRAND_BLEU_ST_GILLES
    }

    enum CategorieActivite {
        INDIVIDUELLE
        PRIVATISATION
    }

    enum TrancheAge {
        ADULTE
        ENFANT
    }

    enum StatutReservation {
        EN_ATTENTE_PAIEMENT
        CONFIRMEE
        ANNULEE
    }
}

' ==========================================================
' ALIGNEMENT VERTICAL DES PACKAGES & ÉLÉMENTS
' ==========================================================
ConfigPkg -[hidden]down-> DomainPkg
DomainPkg -[hidden]down-> EnumPkg

' ==========================================================
' RELATIONS APPLICATIVES DU DOMAINE (Flux vertical)
' ==========================================================
Creneau "0..*" o-down-> "0..1" Alerte : est ciblé par > \n**SPEC-ADMIN-06, SPEC-RESERVATION-03**
Creneau "1" *-down-> "0..*" Reservation : regroupe > \n**SPEC-RESERVATION-03, SPEC-ADMIN-01**
User "1" -down-> "0..*" Reservation : effectue / gère > \n**SPEC-RESERVATION-03, SPEC-ADMIN-04**
Reservation "1" *-down-> "0..*" Billet : contient > \n**SPEC-RESERVATION-03, SPEC-ADMIN-02, SPEC-ADMIN-03**
Reservation "1" -down-> "0..*" Notification : déclenche > \n**SPEC-ADMIN-02, SPEC-ADMIN-03**
Reservation "1" -down-> "0..1" Paiement : est réglée par > \n**SPEC-RESERVATION-03, SPEC-FAC-02**

' ==========================================================
' LIENS DOMAINE <-> ENUMS & CONFIGURATIONS
' ==========================================================
Creneau .down.> ConfigActivite : s'appuie sur > \n**SPEC-RESERVATION-03 (Tarifs/Type)**
Creneau .down.> ConfigPort : s'appuie sur > \n**SPEC-RESERVATION-03 (Jours/Majoration)**
Creneau .down.> ConfigBateau : mobilise > \n**SPEC-ADMIN-01, SPEC-ADMIN-05 (Jauge)**

User -down-> Role
Creneau -down-> TypeActivite
Billet -down-> TrancheAge
Reservation -down-> StatutReservation
ConfigActivite -down-> CategorieActivite

@enduml

@startuml domain
title Diagramme de domaine — Ti'Baleine

skinparam monochrome false
skinparam roundcorner 8
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial

' ─── Acteurs ───

class Utilisateur {
  + nom : string
  + prenom : string
  + email : string
  + telephone : string
  + motDePasse : string
  + role : RoleUtilisateur
}

enum RoleUtilisateur {
  CLIENT
  ADMINISTRATEUR
}

' ─── Catalogue ───

class Sortie {
  + nom : string
  + type : TypeSortie
  + prixAdulte : float
  + prixEnfant : float
}

enum TypeSortie {
  SORTIE_BALEINES
  SORTIE_DAUPHINS
  PRIVATISATION_TIKAP
  PRIVATISATION_GRAND_BLEU
}

class Navire {
  + nom : string
  + capacite : int
}

class Port {
  + nom : string
  + supplementTarifaire : float
}

' ─── Planification ───

class Creneau {
  + date : Date
  + heure : HeureDepart
  + jauge : int
  + / placesReservees : int
  + statut : StatutCreneau
  + sousAlerte : bool
  + naturalisteAffecte : bool
}

enum StatutCreneau {
  DISPONIBLE
  COMPLET
  ANNULE
  FERME
}

enum HeureDepart {
  H07
  H09
  H10
  H14
}

' ─── Réservation ───

class Reservation {
  + reference : string
  + statut : StatutReservation
  + / montantTotal : float
  + dateCreation : DateTime
  + nombreAdultes : int
  + nombreEnfants : int
  + motifAnnulation : MotifAnnulation
  + numeroFacture : string
  + statutEmissionFacture : StatutFacture
  + dateEmissionFacture : DateTime
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
}

enum MotifAnnulation {
  METEO_SUITE_ALERTE
  CLIENT_SUITE_ALERTE
  ANNULATION_STANDARD
}

class Passager {
  + categorie : CategoriePassager
  + / prixUnitaire : float
}

enum CategoriePassager {
  ADULTE
  ENFANT
  FORFAIT_PRIVATISATION
}

' ─── Paiement ───

class Paiement {
  + montant : float
  + statut : StatutPaiement
  + datePaiement : DateTime
}

enum StatutPaiement {
  REUSSI
  ECHOUE
  REMBOURSE
}

enum StatutFacture {
  ENVOYEE_AVEC_SUCCES
  ECHEC_EMISSION
}

' ─── Alerte de pré-annulation ───

class AlertePreAnnulation {
  + message : string
  + dateEnvoi : DateTime
  + viaSms : bool
  + viaEmail : bool
}

' ─── Relations ───

Utilisateur "1" -- "0..*" Reservation : effectue >
Utilisateur ..> Reservation : gère >

Reservation "1" --> "1" Creneau : concerne >
Creneau "1" --> "0..1" Sortie : propose >
Creneau "1" --> "0..*" Navire : affecté à >
Creneau "1" --> "1" Port : départ depuis >

Reservation "1" *-- "0..*" Passager : comprend >
Passager --> CategoriePassager : type >

Reservation "1" --> "0..*" Paiement : réglée par >

Utilisateur ..> AlertePreAnnulation : déclenche >
AlertePreAnnulation "1" --> "1..*" Creneau : concerne >
Reservation "0..*" --> "0..1" AlertePreAnnulation : annulée suite à >

' ─── Notes métier essentielles ───

note right of Utilisateur
  SPEC-ADMIN-02, SPEC-ADMIN-03,
  SPEC-ADMIN-04, SPEC-ADMIN-06
end note

note right of Creneau
  SPEC-ADMIN-01, SPEC-ADMIN-05,
  SPEC-ADMIN-06, SPEC-ADMIN-07,
  SPEC-RESERVATION-03
end note

note right of Reservation
  SPEC-ADMIN-02, SPEC-ADMIN-03,
  SPEC-FAC-02, SPEC-RESERVATION-03
end note

note right of Passager
  SPEC-ADMIN-02, SPEC-ADMIN-03,
  SPEC-RESERVATION-03
end note

note right of AlertePreAnnulation
  SPEC-ADMIN-06
end note

@enduml
